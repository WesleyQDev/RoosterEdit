{
  "schema": "rooster.category/v1",
  "id": "talking-head",
  "name": "Talking Head",
  "description": "Entrevista, apresentador ou aula com footage real e voz do usuário",
  "extends": null,
  "defaults": {
    "duration": [60, 180],
    "aspect": "16:9",
    "engine": "auto",
    "voice": "user",
    "captions": "burned",
    "music": true,
    "source": "live"
  },
  "structure": [
    { "beat": "hook", "duration": [0, 3], "goal": "Melhor linha ou afirmação surpreendente" },
    { "beat": "setup", "duration": [3, 10], "goal": "Quem, o quê, por quê" },
    { "beat": "body", "duration": [10, 70], "goal": "2 a 4 blocos de história" },
    { "beat": "turn", "duration": [70, 85], "goal": "Insight ou conflito" },
    { "beat": "payoff", "duration": [85, 95], "goal": "Resolução ou prova" },
    { "beat": "cta", "duration": [95, 100], "goal": "Ação clara" }
  ],
  "required": ["footage", "transcript"],
  "optional": ["broll", "images", "music", "lower-thirds"],
  "qa": [
    "melhor linha nos primeiros 3 segundos",
    "sem jump cuts acidentais",
    "b-roll coerente com o áudio",
    "legendas sincronizadas",
    "loudness consistente entre cortes",
    "CTA claro"
  ]
}
